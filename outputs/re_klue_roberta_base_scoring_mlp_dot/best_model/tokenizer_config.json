{
  "backend": "tokenizers",
  "bos_token": "[CLS]",
  "cls_token": "[CLS]",
  "do_basic_tokenize": true,
  "do_lower_case": false,
  "eos_token": "[SEP]",
  "extra_special_tokens": [
    "[SUBJ-PER]",
    "[/SUBJ-PER]",
    "[OBJ-PER]",
    "[/OBJ-PER]",
    "[SUBJ-ORG]",
    "[/SUBJ-ORG]",
    "[OBJ-ORG]",
    "[/OBJ-ORG]",
    "[SUBJ-LOC]",
    "[/SUBJ-LOC]",
    "[OBJ-LOC]",
    "[/OBJ-LOC]",
    "[SUBJ-POH]",
    "[/SUBJ-POH]",
    "[OBJ-POH]",
    "[/OBJ-POH]",
    "[SUBJ-DAT]",
    "[/SUBJ-DAT]",
    "[OBJ-DAT]",
    "[/OBJ-DAT]",
    "[SUBJ-NOH]",
    "[/SUBJ-NOH]",
    "[OBJ-NOH]",
    "[/OBJ-NOH]",
    "[REL]"
  ],
  "is_local": false,
  "local_files_only": false,
  "mask_token": "[MASK]",
  "model_max_length": 512,
  "never_split": null,
  "pad_token": "[PAD]",
  "sep_token": "[SEP]",
  "strip_accents": null,
  "tokenize_chinese_chars": true,
  "tokenizer_class": "BertTokenizer",
  "unk_token": "[UNK]"
}
